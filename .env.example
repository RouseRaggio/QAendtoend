# TestFlow QA Environment Configuration

PROJECT_NAME=TestFlow QA
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=testflow_super_secret_jwt_key_change_in_production_2026

# Database (PostgreSQL for Docker, SQLite for instant zero-dependency local runs)
DATABASE_URL=sqlite:///./testflow.db

# Storage
UPLOAD_DIR=./uploads/evidence
MAX_FILE_SIZE_BYTES=26214400

# AI Provider (mock, openai, ollama)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Jira Integration
JIRA_ENABLED=true
JIRA_BASE_URL=https://gestadoc.atlassian.net
JIRA_EMAIL=qa@gestadoc.com
JIRA_API_TOKEN=
